# Configuration for `recond serve` (the CLI reads RECOND_DB and
# RECOND_PROVIDERS_FILE too). Values are intentionally empty: put real ones in
# your environment or secret store, never in this file.

# SQLite path (default recond.db)
RECOND_DB=
# API + webhook listener (default 127.0.0.1:8080)
RECOND_ADDR=
# pprof + metrics listener; empty disables it
RECOND_ADMIN_ADDR=
# provider rules JSON; empty uses the built-in examples (see `recond config`)
RECOND_PROVIDERS_FILE=
# debug | info | warn | error (default info)
RECOND_LOG_LEVEL=
# graceful shutdown budget (default 20s)
RECOND_SHUTDOWN_TIMEOUT=

# key:principal pairs, comma-separated, keys at least 16 characters. The
# principal is recorded as the resolver in the exception audit trail.
# Empty means the /v1 management API refuses every request.
RECOND_API_KEYS=

# One HMAC secret per provider, at least 16 characters. A provider without a
# secret cannot deliver webhooks.
RECOND_WEBHOOK_SECRET_PSP_A=
RECOND_WEBHOOK_SECRET_BANK_B=
# accepted clock skew for Webhook-Timestamp (default 5m, max 1h)
RECOND_WEBHOOK_TOLERANCE=
